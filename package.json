{
	"name": "obsidian-sidekick-plus",
	"version": "2.0.0",
	"description": "An enhanced AI sidekick for Obsidian. Based on Sidekick by Alex Vieira.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"type-check": "tsc -noEmit -skipLibCheck",
		"deploy:local": "node --no-deprecation deploy-local.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^22.00.0",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"tsx": "^4.21.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^4.1.5"
	},
	"peerDependencies": {
		"@codemirror/state": "^6",
		"@codemirror/view": "^6"
	},
	"dependencies": {
		"@github/copilot-sdk": "^0.3.0",
		"obsidian": "latest"
	}
}
